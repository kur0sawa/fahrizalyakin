---
import { getCollection } from "astro:content";
import SectionTitle from "../ui/SectionTitle.astro";
import { ArrowRight } from "@lucide/astro";

const projects = (
  await getCollection("work", ({ data }) => {
    return data.featured && !data.draft;
  })
)
  .sort(
    (a, b) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  )
  .slice(0, 3);
---

<section
  class="container border-t border-[var(--color-border)]"
  style="padding-block: var(--section-padding-y);"
>
  <SectionTitle
    title="Featured Projects"
    description="A selection of design, development, and data projects."
    linkLabel="View all work"
    linkHref="/work"
  />

  {
    projects.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <article class="group flex min-h-72 flex-col rounded-card border border-[var(--color-border)] bg-surface p-6 transition duration-300 hover:-translate-y-1 hover:border-brand-500 hover:shadow-[var(--shadow-card)]">
            <p class="font-code text-sm font-medium text-brand-600">
              {project.data.category}
            </p>

            <div class="mt-auto pt-16">
              <h3 class="font-heading text-xl font-semibold tracking-tight">
                {project.data.title}
              </h3>

              <p class="mt-3 leading-7 text-foreground-muted">
                {project.data.description}
              </p>

              <a
                href={`/work/${project.id}`}
                class="mt-6 inline-flex items-center gap-2 font-medium text-foreground transition group-hover:text-brand-600"
                aria-label={`View ${project.data.title}`}
              >
                View project

                <ArrowRight
                    aria-hidden="true"
                    size={18}
                    stroke-width={2}
                    class="transition-transform group-hover:translate-x-1"
                />
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="text-foreground-muted">
        Featured projects will appear here soon.
      </p>
    )
  }
</section>