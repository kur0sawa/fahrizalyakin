---
import SectionTitle from "../ui/SectionTitle.astro";
import { currentFocus } from "../../data/current-focus";
---

<section
  class="container border-t border-[var(--color-border)]"
  style="padding-block: var(--section-padding-y);"
>
  <SectionTitle
    title="Current Focus"
    description="What I am currently building, learning, and exploring."
  />

  <ul
    class="grid gap-px overflow-hidden rounded-card border border-[var(--color-border)] bg-[var(--color-border)] md:grid-cols-3"
  >
    {
      currentFocus.map((item) => (
        <li class="bg-surface p-6 sm:p-8">
          <p class="font-code text-sm font-medium text-brand-600">
            {item.category}
          </p>

          <h3 class="mt-4 font-heading text-xl font-semibold tracking-tight">
            {item.title}
          </h3>

          <p class="mt-3 leading-7 text-foreground-muted">
            {item.description}
          </p>
        </li>
      ))
    }
  </ul>
</section>