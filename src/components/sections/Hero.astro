---
import { hero } from "../../data/site";
---

<section
  class="container flex items-center"
  style="min-height: calc(100vh - var(--header-height)); padding-block: var(--section-padding-y);"
>
  <div class="max-w-3xl">
    <p class="mb-5 font-code text-sm font-medium text-brand-600">
      {hero.greeting}
    </p>

    <h1
      class="font-heading text-5xl leading-tight font-semibold tracking-tight sm:text-6xl lg:text-7xl"
    >
      {
        hero.title.map((line) => (
          <span class="block">{line}</span>
        ))
      }
    </h1>

    <p
      class="mt-8 max-w-2xl text-lg leading-8 text-foreground-muted sm:text-xl"
    >
      {hero.description}
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={hero.cta.primary.href}
        class="rounded-lg bg-brand-600 px-5 py-3 font-medium text-white transition hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        {hero.cta.primary.label}
      </a>

      <a
        href={hero.cta.secondary.href}
        class="rounded-lg border border-slate-200 px-5 py-3 font-medium transition hover:bg-surface-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        {hero.cta.secondary.label}
      </a>
    </div>
  </div>
</section>