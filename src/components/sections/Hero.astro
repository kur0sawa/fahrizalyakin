---
import Button from "../ui/Button.astro";
import { hero } from "../../data/site";
---

<section
  class="container flex items-center"
  style="min-height: calc(100vh - var(--header-height)); padding-block: var(--section-padding-y);"
>
  <div class="max-w-3xl">
    <p class="mb-5 font-code text-sm font-medium text-brand-600">
      {hero.greeting}
    </p>

    <h1
      class="font-heading text-4xl leading-tight font-semibold tracking-tight sm:text-6xl lg:text-7xl"
    >
      {
        hero.title.map((line) => (
          <span class="block">{line}</span>
        ))
      }
    </h1>

    <p
      class="mt-8 max-w-2xl text-lg leading-8 text-foreground-muted sm:text-xl"
    >
      {hero.description}
    </p>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
  <Button
  href={hero.cta.primary.href}
  showArrow
>
  {hero.cta.primary.label}
</Button>

  <Button
    href={hero.cta.secondary.href}
    variant="secondary"
  >
    {hero.cta.secondary.label}
  </Button>
</div>
  </div>
</section>