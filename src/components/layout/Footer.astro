---
import PhEnvelope from "../icons/PhEnvelope.astro";
import PhGithubLogo from "../icons/PhGithubLogo.astro";
import PhInstagramLogo from "../icons/PhInstagramLogo.astro";
import PhRss from "../icons/PhRss.astro";

import { socialLinks } from "../../config/social";

const currentYear = new Date().getFullYear();

const icons = {
  github: PhGithubLogo,
  instagram: PhInstagramLogo,
  mail: PhEnvelope,
  rss: PhRss,
};
---

<footer class="border-t border-[var(--color-border)] bg-surface">
  <div
    class="container flex flex-col gap-8 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <p class="font-heading font-medium tracking-tight">
        Fahrizal Yakin
      </p>

      <p class="mt-1 text-sm text-foreground-muted">
        Design × Code × Data
      </p>
    </div>

    <nav aria-label="Social links">
      <ul class="flex flex-wrap items-center gap-2">
        {
          socialLinks.map((item) => {
            const Icon = icons[item.icon];
            const isExternal = item.href.startsWith("http");

            return (
              <li>
                <a
                  href={item.href}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noreferrer" : undefined}
                  aria-label={item.label}
                  title={item.label}
                  class="inline-flex size-10 items-center justify-center rounded-lg text-foreground-muted transition hover:bg-brand-50 hover:text-brand-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
                >
                  <Icon
                    aria-hidden="true"
                    size={19}
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <p class="text-sm text-foreground-muted">
      © {currentYear}
    </p>
  </div>
</footer>