---
import PhArrowRight from "../icons/PhArrowRight.astro";

interface Props {
  title: string;
  description?: string;
  linkLabel?: string;
  linkHref?: string;
}

const {
  title,
  description,
  linkLabel,
  linkHref,
} = Astro.props;

const showLink = linkLabel && linkHref;
---

<div
  class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"
>
  <div class="max-w-2xl">
    <h2
      class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl"
    >
      {title}
    </h2>

    {
      description && (
        <p class="mt-3 text-base leading-7 text-foreground-muted sm:text-lg">
          {description}
        </p>
      )
    }
  </div>

  {
    showLink && (
      <a
        href={linkHref}
        class="group inline-flex shrink-0 items-center gap-2 font-medium text-brand-600 transition hover:text-brand-700"
      >
        {linkLabel}

        <PhArrowRight
          aria-hidden="true"
          size={18}
          class="transition-transform group-hover:translate-x-1"
        />
      </a>
    )
  }
</div>