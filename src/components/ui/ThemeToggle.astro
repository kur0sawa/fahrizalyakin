---
import PhMoon from "../icons/PhMoon.astro";
import PhSun from "../icons/PhSun.astro";
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch to dark mode"
  class="inline-flex size-10 items-center justify-center rounded-lg text-foreground-muted transition hover:bg-surface-muted hover:text-brand-600"
>
  <PhMoon
    data-theme-dark-icon
    aria-hidden="true"
    size={20}
  />

  <PhSun
    data-theme-light-icon
    aria-hidden="true"
    size={20}
    class="hidden"
  />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  const darkIcon = document.querySelector<HTMLElement>(
    "[data-theme-dark-icon]",
  );

  const lightIcon = document.querySelector<HTMLElement>(
    "[data-theme-light-icon]",
  );

  function updateThemeButton() {
    const isDark = document.documentElement.classList.contains("dark");

    button?.setAttribute(
      "aria-label",
      isDark ? "Switch to light mode" : "Switch to dark mode",
    );

    darkIcon?.classList.toggle("hidden", isDark);
    lightIcon?.classList.toggle("hidden", !isDark);
  }

  button?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");

    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateThemeButton();
  });

  updateThemeButton();
</script>