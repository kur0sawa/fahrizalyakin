---
import BaseLayout from "../layouts/BaseLayout.astro";

const experiments = [
  {
    category: "Design",
    title: "Interface Studies",
    description:
      "Small explorations of layout, typography, color, and interaction patterns.",
    status: "Exploring",
  },
  {
    category: "Development",
    title: "Creative Coding",
    description:
      "Tiny browser experiments built while learning new web technologies.",
    status: "Coming soon",
  },
  {
    category: "Data",
    title: "Visual Experiments",
    description:
      "Experiments in presenting information through clear and useful visual forms.",
    status: "Coming soon",
  },
];
---

<BaseLayout
  title="Playground"
  description="Small experiments across design, development, and data."
>
  <section
    class="container"
    style="padding-block: var(--section-padding-y);"
  >
    <header class="max-w-3xl">
      <p class="font-code text-sm font-medium text-brand-600">
        Playground
      </p>

      <h1
        class="mt-5 font-heading text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      >
        Small experiments, unfinished ideas, and curious detours.
      </h1>

      <p
        class="mt-6 max-w-2xl text-lg leading-8 text-foreground-muted sm:text-xl"
      >
        A space for visual studies, coding experiments, and data explorations
        that do not need to become full projects.
      </p>
    </header>

    <div class="mt-16 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        experiments.map((experiment) => (
          <article class="flex min-h-72 flex-col rounded-card border border-slate-200 bg-surface p-6 sm:p-8">
            <div class="flex items-center justify-between gap-4">
              <p class="font-code text-sm font-medium text-brand-600">
                {experiment.category}
              </p>

              <span class="rounded-full bg-surface-muted px-3 py-1 text-xs font-medium text-foreground-muted">
                {experiment.status}
              </span>
            </div>

            <div class="mt-auto pt-16">
              <h2 class="font-heading text-2xl font-semibold tracking-tight">
                {experiment.title}
              </h2>

              <p class="mt-4 leading-7 text-foreground-muted">
                {experiment.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>