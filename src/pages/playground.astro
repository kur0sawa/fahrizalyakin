---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Playground"
  description="Small experiments in design, software, and data visualization."
>
  <section class="container py-20 sm:py-24">
    <p class="font-code text-sm font-medium text-brand-600">Playground</p>

    <h1 class="mt-4 font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
      Experiments, prototypes, and tiny tools.
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-foreground-muted">
      A laboratory for ideas that are still being explored.
    </p>
  </section>
</BaseLayout>