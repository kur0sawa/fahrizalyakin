---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="About Fahrizal Yakin, a designer, developer, and data scientist."
>
  <section class="container py-20 sm:py-24">
    <p class="font-code text-sm font-medium text-brand-600">About</p>

    <h1 class="mt-4 font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
      Designer, developer, and data scientist.
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-foreground-muted">
      I combine visual thinking, software development, and data exploration to
      build thoughtful digital experiences.
    </p>
  </section>
</BaseLayout>