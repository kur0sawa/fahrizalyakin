---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Work"
  description="Selected design, development, and data science projects."
>
  <section class="container py-20 sm:py-24">
    <p class="font-code text-sm font-medium text-brand-600">Work</p>

    <h1 class="mt-4 font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
      Selected projects and case studies.
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-foreground-muted">
      A collection of projects across design, software development, and data
      science.
    </p>
  </section>
</BaseLayout>