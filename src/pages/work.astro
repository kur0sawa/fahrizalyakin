---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhArrowRight from "../components/icons/PhArrowRight.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import TagList from "../components/ui/TagList.astro";

const projects = (
  await getCollection("work", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout
  title="Work"
  description="Selected projects across design, software development, and data."
>
  <section
    class="container"
    style="padding-block: var(--section-padding-y);"
  >
    <PageHeader
      eyebrow="Work"
      title="Projects I have designed, built, and explored."
      description="A collection of work across visual design, software development, and data."
    />

    {
      projects.length > 0 ? (
        <div class="mt-16 grid gap-5 md:grid-cols-2">
          {projects.map((project) => (
            <article class="group flex min-h-80 flex-col rounded-card border border-[var(--color-border)] bg-surface p-6 transition duration-300 hover:-translate-y-1 hover:border-brand-500 hover:shadow-[var(--shadow-card)] sm:p-8">
              <div class="flex flex-wrap items-center gap-3 font-code text-sm">
                <span class="font-medium text-brand-600">
                  {project.data.category}
                </span>

                <span aria-hidden="true" class="text-[var(--color-border)]">
                  /
                </span>

                <time
                  datetime={project.data.publishedAt.toISOString()}
                  class="text-foreground-muted"
                >
                  {project.data.publishedAt.toLocaleDateString("en-US", {
                    year: "numeric",
                  })}
                </time>
              </div>

              <div class="mt-auto pt-16">
                <h2
                  class="font-heading text-2xl font-semibold tracking-tight"
                >
                  <a
                    href={`/work/${project.id}`}
                    class="transition group-hover:text-brand-600"
                  >
                    {project.data.title}
                  </a>
                </h2>

                <p class="mt-4 leading-7 text-foreground-muted">
                  {project.data.description}
                </p>

                <TagList
                  items={project.data.technologies}
                  limit={4}
                  class="mt-6"
                />

                <a
                  href={`/work/${project.id}`}
                  class="mt-8 inline-flex items-center gap-2 font-medium text-foreground transition group-hover:text-brand-600"
                  aria-label={`View ${project.data.title}`}
                >
                  View project

                  <PhArrowRight
                    aria-hidden="true"
                    size={18}
                    class="transition-transform group-hover:translate-x-1"
                  />
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-16 rounded-card border border-[var(--color-border)] p-8">
          <p class="text-foreground-muted">
            Projects will appear here soon.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>