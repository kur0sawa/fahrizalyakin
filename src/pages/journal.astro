---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Journal"
  description="Notes and articles about design, code, and data."
>
  <section class="container py-20 sm:py-24">
    <p class="font-code text-sm font-medium text-brand-600">Journal</p>

    <h1 class="mt-4 font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
      Notes from learning and building.
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-foreground-muted">
      Articles, tutorials, observations, and lessons gathered along the way.
    </p>
  </section>
</BaseLayout>