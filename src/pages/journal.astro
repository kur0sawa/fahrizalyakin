---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhArrowRight from "../components/icons/PhArrowRight.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import TagList from "../components/ui/TagList.astro";

const articles = (
  await getCollection("journal", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout
  title="Journal"
  description="Notes about design, software development, data, and the things I learn along the way."
>
  <section
    class="container"
    style="padding-block: var(--section-padding-y);"
  >
    <PageHeader
      eyebrow="Journal"
      title="Notes from things I build, learn, and explore."
      description="Writing about design, software development, data, and the process behind the work."
    />

    {
      articles.length > 0 ? (
        <div class="mt-16 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
          {articles.map((article) => (
            <article class="group py-8 sm:py-10">
              <div class="grid gap-5 md:grid-cols-[10rem_1fr] md:gap-10">
                <div class="font-code text-sm">
                  <time
                    datetime={article.data.publishedAt.toISOString()}
                    class="text-foreground-muted"
                  >
                    {article.data.publishedAt.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>

                  <p class="mt-2 font-medium text-brand-600">
                    {article.data.category}
                  </p>
                </div>

                <div class="max-w-3xl">
                  <h2
                    class="font-heading text-2xl font-semibold leading-snug tracking-tight sm:text-3xl"
                  >
                    <a
                      href={`/journal/${article.id}`}
                      class="transition group-hover:text-brand-600"
                    >
                      {article.data.title}
                    </a>
                  </h2>

                  <p class="mt-4 leading-7 text-foreground-muted">
                    {article.data.description}
                  </p>

                  <TagList
                    items={article.data.tags}
                    limit={4}
                    class="mt-5"
                  />

                  <a
                    href={`/journal/${article.id}`}
                    class="mt-6 inline-flex items-center gap-2 font-medium text-foreground transition group-hover:text-brand-600"
                    aria-label={`Read ${article.data.title}`}
                  >
                    Read article

                    <PhArrowRight
                      aria-hidden="true"
                      size={18}
                      class="transition-transform group-hover:translate-x-1"
                    />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-16 rounded-card border border-[var(--color-border)] p-8">
          <p class="text-foreground-muted">
            Journal entries will appear here soon.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>